          "type": "text",
          "plainText": "// 비전 좌표 전달을 위한 FreeRTOS Queue 생성\nQueueHandle_t xCoordQueue;\ntypedef struct {\n  int16_t x;\n  int16_t y;\n  int16_t z;\n} VisionTarget_t;\n\nvoid vTaskVisionParse(void *pvParameters) {\n  VisionTarget_t target;\n  for(;;) {\n    if (parseUartVisionPacket(&target) == STATUS_OK) {\n      xQueueSend(xCoordQueue, &target, portMAX_DELAY);\n    }\n    vTaskDelay(pdMS_TO_TICKS(20));\n  }\n}",
          "annotations": {

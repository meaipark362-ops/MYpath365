      "richText": [
        {
          "type": "text",
          "plainText": "// 거리 비례 햅틱 피드백 알고리즘\nfloat distance = (duration * 0.0343) / 2;\nif (distance > 0 && distance < 150) {\n  // 150cm 이내 장애물 감지 시 거리가 가까울수록 고주파 펄스 진동\n  int pwmDuty = map(distance, 10, 150, 255, 60);\n  analogWrite(VIB_PIN, pwmDuty);\n} else {\n  analogWrite(VIB_PIN, 0);\n}",
          "annotations": {
            "bold": false,
            "italic": false,
